APP_NAME="SadSha Build"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
#
# Production (Contabo VPS 8, shared with Massing — see docs/saas/contabo-vps8-shared.md):
# the compose stack sets these from the VPS .env. MySQL 8 is the prod database;
# SQLite above is dev/test only. DB_PASSWORD is REQUIRED in prod — the stack must
# not boot with the empty default. Never commit a real value here.
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=sadsha_build
# DB_USERNAME=sadsha_build
# DB_PASSWORD=CHANGEME-generate-with-openssl-rand-hex-24
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
#
# Settings SQLite (config/settings-db.php): in the compose stack this is pointed
# at the persistent storage volume so settings survive a container recreate.
# SETTINGS_DB_PATH=/var/www/html/storage/app/settings.data

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

SEED_DEMO_DATA=false

# Scheduler Configuration
# Claim window (in seconds) for preventing duplicate task dispatch
# Default: 300 (5 minutes) - Increase for slow/unreliable cron environments like Bluehost
SCHEDULER_CLAIM_WINDOW_SECONDS=300

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CPANEL_URL=
CPANEL_USERNAME=
CPANEL_API_TOKEN=
CPANEL_DOMAIN=
CPANEL_PORT=2083
CPANEL_WEBMAIL_PORT=2096
CPANEL_WEBMAIL_URL=
CPANEL_DEFAULT_EMAIL_QUOTA=250
CPANEL_AUTO_CREATE_EMAILS=false
CPANEL_AUTO_DELETE_EMAILS=true
CPANEL_SYNC_USER_PASSWORDS=false
CPANEL_VERIFY_SSL=true
CPANEL_TIMEOUT=30
CPANEL_CONNECT_TIMEOUT=10

VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

GOOGLE_VISION_API_KEY=
GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/files:annotate
GOOGLE_VISION_TIMEOUT=30
GOOGLE_VISION_CONNECT_TIMEOUT=5

PLANS_OCR_DRIVER=google-vision
PLANS_OCR_FALLBACK_ENABLED=false
PLANS_OCR_MIN_TEXT_LENGTH=12
PLANS_TITLE_BLOCK_REGION=bottom-right

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SadSha Build — SaaS + shared-hosting variables (hosting prep, 2026-11-11)
# See docs/saas/contabo-vps8-shared.md. All values here are safe placeholders —
# generate real secrets on the VPS only, never commit them.
# ---------------------------------------------------------------------------

# Public hostname for this app on the shared Contabo VPS 8 (TBD — replace the
# placeholder with the real domain before first boot; DNS A record must point
# at the VPS first, or Caddy cannot issue a certificate).
FIELDJIG_DOMAIN=app.example.com
# Massing's public hostname on the same box (its own doc owns the value; the
# shared Caddyfile needs both names in one place).
MASSING_DOMAIN=app.example.com
# Host port for this app's nginx, localhost-bound only (Massing uses 8080).
FIELDJIG_WEB_PORT=8081
# Massing's web port on the same box (owned by Massing's guide; the shared
# Caddyfile proxies to it — keep the two guides in agreement).
MASSING_WEB_PORT=8080

# Prod MySQL credentials (compose stack only; harmless under the SQLite dev
# default — MySQL is never touched unless DB_CONNECTION=mysql). DB_PASSWORD
# and DB_ROOT_PASSWORD are REQUIRED in prod and have no safe default: the
# MySQL image refuses to initialise with them empty (fail-closed, §4.1).
# DB_PASSWORD itself stays commented in the prod block above — generate it on
# the VPS with `openssl rand -hex 24`, never commit a real value.
DB_DATABASE=sadsha_build
DB_USERNAME=sadsha_build
DB_PORT=3306
DB_ROOT_PASSWORD=
# Opt-in MySQL memory cap for the commented-out deploy.resources.limits
# block in docker-compose.yml (off by default on purpose — see the guide §10).
# FIELDJIG_MYSQL_MEM_LIMIT=1g

# SaaS mode: 0 = single-tenant dev behaviour (default, unchanged); 1 = org
# scoping + trial limits + billing panel (Remixer Agents T/B/P own the code
# that reads this; empty billing values below mean "billing not configured").
SAAS_MODE=0
BILLING_PROVIDER=lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Flat monthly price in USD for the Pro plan (one variant = one price).
SADSHA_BUILD_PRICE_MONTHLY=99

# Prod app key — REQUIRED in prod; APP_KEY at the top of this file must be set
# on the VPS. Generate it there, never reuse a dev key:
#   docker compose exec app php artisan key:generate --show

# Trial length in days for a new organization (Remixer §1/§3).
SADSHA_BUILD_TRIAL_DAYS=30

